<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cloudai</groupId>
        <artifactId>cloud-ai</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>cloud-ai-spring</artifactId>
    <packaging>jar</packaging>
    <name>Cloud AI Spring Boot Integration</name>
    <description>Spring Boot 自动装配集成层 — 可选依赖，用 Spring DI 装配 cloud-ai 各模块</description>

    <properties>
        <spring-boot.version>4.1.0</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- cloud-ai 框架模块 -->
        <dependency>
            <groupId>com.cloudai</groupId>
            <artifactId>cloud-ai-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudai</groupId>
            <artifactId>cloud-ai-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudai</groupId>
            <artifactId>cloud-ai-persona</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudai</groupId>
            <artifactId>cloud-ai-context</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudai</groupId>
            <artifactId>cloud-ai-skills</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudai</groupId>
            <artifactId>cloud-ai-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudai</groupId>
            <artifactId>cloud-ai-execution</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudai</groupId>
            <artifactId>cloud-ai-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudai</groupId>
            <artifactId>cloud-ai-server</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>