# Cloud AI 环境变量配置
# 复制此文件为 .env 并填入真实密钥（.env 已在 .gitignore 中，不会被提交）
#
# PowerShell 设置环境变量：
#   $env:OPENAI_API_KEY = "sk-xxx"
#   $env:OPENAI_MODEL = "gpt-4o"
#
# 或在运行时通过 JVM 系统属性传入：
#   mvn compile exec:java -pl cloud-ai-example -DOPENAI_API_KEY=sk-xxx -DOPENAI_MODEL=gpt-4o

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
